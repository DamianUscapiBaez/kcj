# Copia este archivo a .env y completa los valores. NUNCA subas .env al repositorio.
DATABASE_URL="postgresql://USUARIO:CONTRASEÑA@localhost:5432/cotizaciones_db?schema=public"

# Genera uno con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=""

# Solo para prisma/set-password.ts (mínimo 12 caracteres). Bórrala del .env después de usarla.
# SEED_PASSWORD=""

# URL pública HTTPS de tu aplicación, usada en el QR del PDF
APP_URL="http://localhost:3000"
