// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyRole {
  OWNER
  ADMIN
  SALES
  VIEWER
}

enum DocumentType {
  RUC
  DNI
  CE
  PASSPORT
  OTHER
}

enum Currency {
  PEN
  USD
}

enum RateUnit {
  HOUR
  DAY
  TRIP
  SERVICE
  MONTH
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  OTHER
}

model Company {
  id           String               @id @default(uuid()) @db.Uuid
  taxId        String               @unique @map("tax_id") @db.VarChar(20)
  legalName    String               @map("legal_name") @db.VarChar(200)
  tradeName    String?              @map("trade_name") @db.VarChar(200)
  address      String?
  email        String?              @db.VarChar(200)
  phone        String?              @db.VarChar(40)
  logoUrl      String?              @map("logo_url")
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  settings     CompanySettings?
  bankAccounts CompanyBankAccount[]
  memberships  CompanyUser[]
  clients      Client[]
  services     Service[]
  vehicleTypes VehicleType[]
  rates        ServiceRate[]
  quotations   Quotation[]
  sequences    QuotationSequence[]

  @@map("companies")
}

model CompanySettings {
  companyId           String   @id @map("company_id") @db.Uuid
  defaultCurrency     Currency @default(PEN) @map("default_currency")
  defaultTaxRate      Decimal  @default(18.00) @map("default_tax_rate") @db.Decimal(5, 2)
  defaultValidityDays Int      @default(7) @map("default_validity_days")
  quotationPrefix     String   @default("CT") @map("quotation_prefix") @db.VarChar(10)
  defaultTerms        String?  @map("default_terms")
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

model CompanyBankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  bankName      String   @map("bank_name") @db.VarChar(100)
  accountName   String?  @map("account_name") @db.VarChar(200)
  accountNumber String   @map("account_number") @db.VarChar(60)
  cci           String?  @db.VarChar(60)
  currency      Currency
  isDetraction  Boolean  @default(false) @map("is_detraction")
  isActive      Boolean  @default(true) @map("is_active")
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, isActive])
  @@map("company_bank_accounts")
}

model User {
  id                String                   @id @default(uuid()) @db.Uuid
  name              String                   @db.VarChar(160)
  email             String                   @unique @db.VarChar(200)
  passwordHash      String?                  @map("password_hash")
  isActive          Boolean                  @default(true) @map("is_active")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  memberships       CompanyUser[]
  createdQuotations Quotation[]              @relation("QuotationCreator")
  statusChanges     QuotationStatusHistory[]

  @@map("users")
}

model CompanyUser {
  companyId String      @map("company_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      CompanyRole @default(SALES)
  joinedAt  DateTime    @default(now()) @map("joined_at")
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
  @@map("company_users")
}

model Client {
  id             String          @id @default(uuid()) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  documentType   DocumentType    @default(RUC) @map("document_type")
  documentNumber String          @map("document_number") @db.VarChar(30)
  legalName      String          @map("legal_name") @db.VarChar(200)
  address        String?
  email          String?         @db.VarChar(200)
  phone          String?         @db.VarChar(40)
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contacts       ClientContact[]
  quotations     Quotation[]

  @@unique([companyId, documentType, documentNumber])
  @@unique([id, companyId])
  @@index([companyId, legalName])
  @@map("clients")
}

model ClientContact {
  id        String  @id @default(uuid()) @db.Uuid
  clientId  String  @map("client_id") @db.Uuid
  name      String  @db.VarChar(160)
  email     String? @db.VarChar(200)
  phone     String? @db.VarChar(40)
  position  String? @db.VarChar(100)
  isPrimary Boolean @default(false) @map("is_primary")
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("client_contacts")
}

model VehicleType {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  name        String          @db.VarChar(120)
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rates       ServiceRate[]
  items       QuotationItem[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("vehicle_types")
}

model Service {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  code        String          @db.VarChar(40)
  name        String          @db.VarChar(160)
  description String?
  isActive    Boolean         @default(true) @map("is_active")
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rates       ServiceRate[]
  items       QuotationItem[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("services")
}

model ServiceRate {
  id            String          @id @default(uuid()) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  serviceId     String          @map("service_id") @db.Uuid
  vehicleTypeId String?         @map("vehicle_type_id") @db.Uuid
  name          String          @db.VarChar(160)
  unit          RateUnit
  currency      Currency
  price         Decimal         @db.Decimal(18, 2)
  validFrom     DateTime?       @map("valid_from") @db.Date
  validUntil    DateTime?       @map("valid_until") @db.Date
  isActive      Boolean         @default(true) @map("is_active")
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  service       Service         @relation(fields: [serviceId, companyId], references: [id, companyId], onDelete: Restrict)
  vehicleType   VehicleType?    @relation(fields: [vehicleTypeId, companyId], references: [id, companyId], onDelete: Restrict)
  items         QuotationItem[]

  @@unique([id, companyId])
  @@index([companyId, serviceId, vehicleTypeId, isActive])
  @@map("service_rates")
}

model QuotationSequence {
  companyId  String  @map("company_id") @db.Uuid
  year       Int
  lastNumber Int     @default(0) @map("last_number")
  company    Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@id([companyId, year])
  @@map("quotation_sequences")
}

model Quotation {
  id                String                   @id @default(uuid()) @db.Uuid
  companyId         String                   @map("company_id") @db.Uuid
  clientId          String                   @map("client_id") @db.Uuid
  createdById       String                   @map("created_by_id") @db.Uuid
  year              Int
  number            Int
  code              String                   @db.VarChar(40)
  status            QuotationStatus          @default(DRAFT)
  issueDate         DateTime                 @default(now()) @map("issue_date") @db.Date
  expiryDate        DateTime                 @map("expiry_date") @db.Date
  currency          Currency                 @default(PEN)
  taxRate           Decimal                  @default(18.00) @map("tax_rate") @db.Decimal(5, 2)
  taxIncluded       Boolean                  @default(false) @map("tax_included")
  subtotal          Decimal                  @default(0) @db.Decimal(18, 2)
  taxAmount         Decimal                  @default(0) @map("tax_amount") @db.Decimal(18, 2)
  total             Decimal                  @default(0) @db.Decimal(18, 2)
  paymentTerms      String?                  @map("payment_terms")
  terms             String?
  notes             String?
  contactName       String?                  @map("contact_name") @db.VarChar(160)
  contactEmail      String?                  @map("contact_email") @db.VarChar(200)
  clientDocument    String                   @map("client_document") @db.VarChar(30)
  clientName        String                   @map("client_name") @db.VarChar(200)
  clientAddress     String?                  @map("client_address")
  sellerName        String?                  @map("seller_name") @db.VarChar(160)
  route             String?                  @db.VarChar(160)
  shift             String?                  @db.VarChar(60)
  verificationToken String?                  @unique @default(uuid())
  issuedAt          DateTime?
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  company           Company                  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client            Client                   @relation(fields: [clientId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy         User                     @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  items             QuotationItem[]
  statusHistory     QuotationStatusHistory[]
  review            QuotationReview?

  @@unique([companyId, year, number])
  @@unique([companyId, code])
  @@unique([id, companyId])
  @@index([companyId, status, issueDate])
  @@index([companyId, clientId])
  @@map("quotations")
}

model QuotationItem {
  id                 String       @id @default(uuid()) @db.Uuid
  quotationId        String       @map("quotation_id") @db.Uuid
  companyId          String       @map("company_id") @db.Uuid
  serviceId          String?      @map("service_id") @db.Uuid
  vehicleTypeId      String?      @map("vehicle_type_id") @db.Uuid
  serviceRateId      String?      @map("service_rate_id") @db.Uuid
  position           Int
  description        String
  vehicleDescription String?      @map("vehicle_description") @db.VarChar(160)
  unit               RateUnit
  quantity           Decimal      @db.Decimal(12, 2)
  unitPrice          Decimal      @map("unit_price") @db.Decimal(18, 2)
  discountAmount     Decimal      @default(0) @map("discount_amount") @db.Decimal(18, 2)
  lineTotal          Decimal      @map("line_total") @db.Decimal(18, 2)
  serviceStart       DateTime?    @map("service_start") @db.Date
  serviceEnd         DateTime?    @map("service_end") @db.Date
  startTime          DateTime?    @map("start_time") @db.Time(0)
  endTime            DateTime?    @map("end_time") @db.Time(0)
  quotation          Quotation    @relation(fields: [quotationId, companyId], references: [id, companyId], onDelete: Cascade)
  service            Service?     @relation(fields: [serviceId, companyId], references: [id, companyId], onDelete: Restrict)
  vehicleType        VehicleType? @relation(fields: [vehicleTypeId, companyId], references: [id, companyId], onDelete: Restrict)
  serviceRate        ServiceRate? @relation(fields: [serviceRateId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([quotationId, position])
  @@index([companyId, serviceId])
  @@map("quotation_items")
}

model QuotationStatusHistory {
  id          String           @id @default(uuid()) @db.Uuid
  quotationId String           @map("quotation_id") @db.Uuid
  changedById String           @map("changed_by_id") @db.Uuid
  fromStatus  QuotationStatus? @map("from_status")
  toStatus    QuotationStatus  @map("to_status")
  note        String?
  changedAt   DateTime         @default(now()) @map("changed_at")
  quotation   Quotation        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  changedBy   User             @relation(fields: [changedById], references: [id], onDelete: Restrict)

  @@index([quotationId, changedAt])
  @@map("quotation_status_histories")
}

model QuotationReview {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @unique @map("quotation_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt   DateTime  @map("expires_at")
  respondedAt DateTime? @map("responded_at")
  observation String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("quotation_reviews")
}